{
  "name": "repo-analyzer",
  "version": "1.0.0",
  "description": "Analyze codebases and generate AI-friendly JSON artifacts",
  "type": "module",
  "bin": {
    "repo-analyzer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "test:watch": "vitest",
    "analyze": "tsx src/cli.ts analyze",
    "route": "tsx src/cli.ts route",
    "overlay": "tsx src/cli.ts overlay",
    "visualize": "tsx src/visualize.ts",
    "serve": "tsx src/cli.ts serve",
    "serve:watch": "tsx watch src/cli.ts serve",
    "debug": "tsx src/cli.ts debug",
    "verify": "tsx src/verify-tree.ts"
  },
  "keywords": [
    "analyzer",
    "dependency-graph",
    "codebase",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "ts-morph": "^21.0.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
